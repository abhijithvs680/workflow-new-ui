# Platform origin the dev server proxies to, so the browser stays same-origin
# and the existing session cookie is used. Self-signed certificates are fine.
VIZRU_PLATFORM_URL=https://127.0.0.1

# Dev server port (5173/5174 are often taken by other Vizru front-ends).
VIZRU_DEV_PORT=5180

# Build output directory. Leave as `dist` and use `npm run deploy` to publish.
VIZRU_OUT_DIR=dist
